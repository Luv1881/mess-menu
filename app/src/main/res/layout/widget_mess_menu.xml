<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- Day Header with accent bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:background="@color/widget_accent" />

        <TextView
            android:id="@+id/tvWidgetDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Today"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Saturday" />

    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/widget_divider" />

    <!-- Breakfast Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBreakfast"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_breakfast"
            android:contentDescription="Breakfast" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breakfast"
                android:textColor="@color/breakfast_color"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetBreakfast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                tools:text="Bread, Eggs, Tea" />

        </LinearLayout>

    </LinearLayout>

    <!-- Lunch Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivLunch"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lunch"
            android:contentDescription="Lunch" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lunch"
                android:textColor="@color/lunch_color"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetLunch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                tools:text="Rice, Dal, Roti, Salad" />

        </LinearLayout>

    </LinearLayout>

    <!-- Dinner Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivDinner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dinner"
            android:contentDescription="Dinner" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dinner"
                android:textColor="@color/dinner_color"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetDinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                tools:text="Chapati, Paneer, Ice Cream" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
